# extracting data from text to column where all raw data is combined in one sheet of a csv file
# there should be no any xlsx file within that directory, the script will overwrite any cvs file with the same name
# variable to be set by users
raw_data_format <- 'asc'    # sample 'txt', 'asc'
no_of_lines_at_the_BEGINNING_to_Omit <- 14
no_of_lines_at_the_END_to_Omit <- 0
dir_path <- 'C:\Users\sg1985\Documents\WMS_47'
# script begins -----------------------------------------------------------------------------------------------------------------------------------------------------------
setwd(dir_path)
#initializing
myData_i <- NULL
appended_dataframe <- NULL
column_name <- NULL
#getting list of all raw data
fileList <- Sys.glob( paste('*.', raw_data_format, sep = "") )   # <--   provide file extenion
for (eachFile in fileList) {
# read data:
myData_i <- read.table(eachFile, sep='', skip = no_of_lines_at_the_BEGINNING_to_Omit, fill=TRUE)  # <-  skipping 1st nth lines and filling up last m rows which are not data
no_of_row <- dim(myData_i)[1]
#extracting data
myData_i <- myData_i[ 1: (no_of_row - no_of_lines_at_the_END_to_Omit),  ]  # <-- a complete dataset, excluding the last 2 rows that are comments
data_matrix_i <- matrix(unlist(myData_i), ncol = 3, byrow = FALSE)
#appending the data of each file into a matrix
appended_dataframe <- cbind( appended_dataframe, data_matrix_i  )
#assigning the column name of the matrix equaling to the respective file-name
column_name  <- c(column_name, tools::file_path_sans_ext(eachFile),tools::file_path_sans_ext(eachFile),tools::file_path_sans_ext(eachFile))
colnames(appended_dataframe) <- column_name
}
# write to csv
write.csv(  appended_dataframe, file =  'combinedFile.csv',  row.names = F  )
